<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OFDRDataReceiver</RootNamespace>
    <AssemblyName>OFDRDataReceiver</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 按 1920×1080 设计，在 2560×1600 等高 DPI 显示器上以设计尺寸原样渲染，
         避免 WinForms 自动按系统 DPI 缩放导致的控件重叠。 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- 串口通信：.NET 6 未内置 System.IO.Ports，需 NuGet 包（8.0.0 兼容 net6.0-windows） -->
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!-- 访问注册表枚举串口（Microsoft.Win32.Registry） -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <!-- 峰值检测参数配置文件：复制到输出目录（exe 同目录），运行时可被外部修改 -->
  <ItemGroup>
    <None Include="config.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
