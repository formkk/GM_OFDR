<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== 颜色：与 WinForms 版逐项对齐 ===== -->
    <Color x:Key="PageBackgroundColor">#F3F5F8</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#DBE0E7</Color>
    <Color x:Key="AccentColor">#185ABC</Color>
    <Color x:Key="AccentPressedColor">#124898</Color>
    <Color x:Key="TextPrimaryColor">#212529</Color>
    <Color x:Key="TextMutedColor">#6A727D</Color>
    <Color x:Key="DangerColor">#BE2D2D</Color>
    <Color x:Key="SuccessColor">#16825D</Color>
    <Color x:Key="RowFailureColor">#F2F3F5</Color>
    <Color x:Key="GroupBandOddColor">#FFFFFF</Color>
    <Color x:Key="GroupBandEvenColor">#F0F5FC</Color>
    <Color x:Key="GroupTintColor">#E2ECFA</Color>
    <Color x:Key="GridLineColor">#E8ECF2</Color>
    <Color x:Key="AxisColor">#969EAA</Color>
    <Color x:Key="CurveColor">#185ABC</Color>
    <Color x:Key="PeakColor">#CE543C</Color>
    <Color x:Key="RoiBackgroundColor">#EAF2FE</Color>
    <Color x:Key="CursorAColor">#D67A22</Color>
    <Color x:Key="CursorBColor">#1C846C</Color>
    <Color x:Key="CursorBandColor">#16185ABC</Color>
    <Color x:Key="ThresholdColor">#C8D0DC</Color>
    <Color x:Key="HoverColor">#8C929C</Color>
    <Color x:Key="HoverBackgroundColor">#EEF3FB</Color>

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="RowFailureBrush" Color="{StaticResource RowFailureColor}" />
    <SolidColorBrush x:Key="GroupBandOddBrush" Color="{StaticResource GroupBandOddColor}" />
    <SolidColorBrush x:Key="GroupBandEvenBrush" Color="{StaticResource GroupBandEvenColor}" />
    <SolidColorBrush x:Key="GroupTintBrush" Color="{StaticResource GroupTintColor}" />
    <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}" />
    <SolidColorBrush x:Key="AxisBrush" Color="{StaticResource AxisColor}" />
    <SolidColorBrush x:Key="CurveBrush" Color="{StaticResource CurveColor}" />
    <SolidColorBrush x:Key="PeakBrush" Color="{StaticResource PeakColor}" />
    <SolidColorBrush x:Key="RoiBackgroundBrush" Color="{StaticResource RoiBackgroundColor}" />
    <SolidColorBrush x:Key="CursorABrush" Color="{StaticResource CursorAColor}" />
    <SolidColorBrush x:Key="CursorBBrush" Color="{StaticResource CursorBColor}" />
    <SolidColorBrush x:Key="CursorBandBrush" Color="{StaticResource CursorBandColor}" />
    <SolidColorBrush x:Key="ThresholdBrush" Color="{StaticResource ThresholdColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />

    <!-- ===== 字体与字号（WinForms pt → WPF DIP，1pt = 1.333DIP）===== -->
    <FontFamily x:Key="UiFontFamily">Microsoft YaHei</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>

    <sys:Double x:Key="FontSizeBody">12</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11.5</sys:Double>
    <sys:Double x:Key="FontSizeTitle">14</sys:Double>
    <sys:Double x:Key="FontSizeMono">12</sys:Double>
    <sys:Double x:Key="FontSizeMonoSmall">10</sys:Double>

    <!-- ===== 间距、圆角、边框 ===== -->
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="TableRowHeight">26</sys:Double>
    <sys:Double x:Key="TableHeaderHeight">40</sys:Double>

    <CornerRadius x:Key="CardCornerRadius">0</CornerRadius>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <Thickness x:Key="CardPadding">14,8,14,8</Thickness>
    <Thickness x:Key="PagePadding">16,12,16,12</Thickness>
    <Thickness x:Key="PageMargin">16</Thickness>

    <!-- ===== 基础样式 ===== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="MonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource CardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
