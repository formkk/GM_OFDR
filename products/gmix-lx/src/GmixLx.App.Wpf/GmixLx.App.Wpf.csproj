<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GmixLx.App.Wpf</AssemblyName>
    <RootNamespace>GmixLx.App.Wpf</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>..\..\..\gmix\Assets\guangmai.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\..\gmix\Assets\guangmai.ico" Link="Assets\guangmai.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GmixLx.Core\GmixLx.Core.csproj" />
    <ProjectReference Include="..\GmixLx.Orchestration\GmixLx.Orchestration.csproj" />
  </ItemGroup>

</Project>
