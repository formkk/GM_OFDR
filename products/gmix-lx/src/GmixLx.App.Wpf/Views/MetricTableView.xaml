<UserControl x:Class="GmixLx.App.Wpf.Views.MetricTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PageBackgroundBrush}"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="MetricHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,4" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="14" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="ToolTip" Value="{Binding Failure}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource GroupTintBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricGroupCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MetricCellStyle}">
            <Setter Property="Background" Value="{StaticResource GroupTintBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowFailureBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="TableInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 连接与操作 -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="1×8 串口" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Style="{StaticResource TableInputStyle}" Width="72"
                         Text="{Binding Com1x8Text, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="8×8 串口" Style="{StaticResource FieldLabelStyle}" Margin="12,0,6,0" />
                <TextBox Style="{StaticResource TableInputStyle}" Width="72"
                         Text="{Binding Com8x8Text, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="采样次数" Style="{StaticResource FieldLabelStyle}" Margin="12,0,6,0" />
                <TextBox Style="{StaticResource TableInputStyle}" Width="60"
                         Text="{Binding SamplesText, UpdateSourceTrigger=PropertyChanged}" />

                <Button Content="开始测试" Width="96" Height="30" Margin="16,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding CanStart}"
                        Click="OnStartClick" />
                <Button Content="停止" Width="72" Height="30" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanStop}"
                        Click="OnStopClick" />
                <Button Content="导出 CSV" Width="96" Height="30"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanExport}"
                        Click="OnExportClick" />
            </StackPanel>
        </Border>

        <!-- 判据参数 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="空间平均 m" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Style="{StaticResource TableInputStyle}" Width="60"
                         Text="{Binding SpatialAverageText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="时间平均 n" Style="{StaticResource FieldLabelStyle}" Margin="12,0,6,0" />
                <TextBox Style="{StaticResource TableInputStyle}" Width="60"
                         Text="{Binding TemporalAverageText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="开始位置(m)" Style="{StaticResource FieldLabelStyle}" Margin="12,0,6,0" />
                <TextBox Style="{StaticResource TableInputStyle}" Width="72"
                         Text="{Binding MarkAText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="终止位置(m)" Style="{StaticResource FieldLabelStyle}" Margin="12,0,6,0" />
                <TextBox Style="{StaticResource TableInputStyle}" Width="72"
                         Text="{Binding MarkDText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="阈值余量(dB)" Style="{StaticResource FieldLabelStyle}" Margin="12,0,6,0" />
                <TextBox Style="{StaticResource TableInputStyle}" Width="60"
                         Text="{Binding MarginText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>

        <!-- 顶部汇总：整体判定 + 有效/失败/待采集 + 用时 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="2" Padding="8,2" BorderThickness="1"
                        ToolTip="{Binding FailuresSummary}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverallState}" Value="PASS">
                                    <Setter Property="Background" Value="{StaticResource PassBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OverallState}" Value="FAIL">
                                    <Setter Property="Background" Value="{StaticResource FailBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OverallState}" Value="进行中">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding OverallState}" FontWeight="Bold"
                               FontSize="{StaticResource FontSizeSmall}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverallState}" Value="PASS">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverallState}" Value="FAIL">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverallState}" Value="进行中">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="14,0,0,0"
                           Text="{Binding PassCount, StringFormat='有效 {0}'}" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="14,0,0,0"
                           Text="{Binding FailCount, StringFormat='失败 {0}'}" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="14,0,0,0"
                           Text="{Binding PendingCount, StringFormat='待采集 {0}'}" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="14,0,0,0"
                           Text="{Binding ElapsedText, StringFormat='用时 {0}'}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0">
        <DataGrid ItemsSource="{Binding Rows}"
                  ColumnWidth="80"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  IsReadOnly="True"
                  SelectionUnit="FullRow"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource GridLineBrush}"
                  Background="{StaticResource CardBackgroundBrush}"
                  BorderThickness="0"
                  RowHeaderWidth="0"
                  RowHeight="{StaticResource TableRowHeight}"
                  ColumnHeaderHeight="{StaticResource TableHeaderHeight}"
                  ColumnHeaderStyle="{StaticResource MetricHeaderStyle}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{StaticResource GroupBandOddBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEvenGroup}" Value="True">
                            <Setter Property="Background" Value="{StaticResource GroupBandEvenBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFailure}" Value="True">
                            <Setter Property="Background" Value="{StaticResource RowFailureBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="测试&#x0A;组别"
                                    Binding="{Binding GroupText}"
                                    CellStyle="{StaticResource MetricGroupCellStyle}" />
                <DataGridTextColumn Header="IN&#x0A;端口"
                                    Binding="{Binding InText}"
                                    CellStyle="{StaticResource MetricCellStyle}" />
                <DataGridTextColumn Header="OUT&#x0A;端口"
                                    Binding="{Binding OutText}"
                                    CellStyle="{StaticResource MetricCellStyle}" />
                <DataGridTextColumn Header="IL-IN&#x0A;dB"
                                    Binding="{Binding IlInText}"
                                    CellStyle="{StaticResource MetricCellStyle}" />
                <DataGridTextColumn Header="IL-DUT&#x0A;dB"
                                    Binding="{Binding IlDutText}"
                                    CellStyle="{StaticResource MetricCellStyle}" />
                <DataGridTextColumn Header="IL-OUT&#x0A;dB"
                                    Binding="{Binding IlOutText}"
                                    CellStyle="{StaticResource MetricCellStyle}" />
                <DataGridTextColumn Header="RL-IN&#x0A;dB_rel"
                                    Binding="{Binding RlInText}"
                                    CellStyle="{StaticResource MetricCellStyle}" />
                <DataGridTextColumn Header="RL-DUT&#x0A;dB_rel"
                                    Binding="{Binding RlDutText}"
                                    CellStyle="{StaticResource MetricCellStyle}" />
                <DataGridTextColumn Header="RL-OUT&#x0A;dB_rel"
                                    Binding="{Binding RlOutText}"
                                    CellStyle="{StaticResource MetricCellStyle}" />
                <DataGridTextColumn Header="DUT&#x0A;光程(m)"
                                    Binding="{Binding DutPathText}"
                                    CellStyle="{StaticResource MetricCellStyle}" />
                <DataGridTextColumn Header="链路&#x0A;长度(m)"
                                    Binding="{Binding LinkLengthText}"
                                    CellStyle="{StaticResource MetricCellStyle}" />
                <DataGridTemplateColumn Header="状态"
                                        CellStyle="{StaticResource MetricCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="2" Padding="6,1" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasData}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource FailBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="PASS">
                                                <Setter Property="Background" Value="{StaticResource PassBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusText}" FontWeight="Bold"
                                           FontSize="{StaticResource FontSizeSmall}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="PASS">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="FAIL">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Border>
    </Grid>
</UserControl>
