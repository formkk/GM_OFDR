<Window x:Class="GmixLx.App.Wpf.Views.CurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vis="clr-namespace:GmixLx.App.Wpf.Visualization"
        Title="距离域曲线"
        Width="1360" Height="600"
        MinWidth="900" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/GmixLx.App.Wpf;component/Assets/guangmai.ico"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource CardStyle}" Margin="{StaticResource PageMargin}" Padding="10,8,10,6">
        <vis:CurvePlotControl x:Name="Plot" />
    </Border>
</Window>
