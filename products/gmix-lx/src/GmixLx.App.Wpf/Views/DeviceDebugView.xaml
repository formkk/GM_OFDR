<UserControl x:Class="GmixLx.App.Wpf.Views.DeviceDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vis="clr-namespace:GmixLx.App.Wpf.Visualization"
             Background="{StaticResource PageBackgroundBrush}"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ParamInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,8,4" />
        </Style>

        <Style x:Key="PeakHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="PeakRightHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource PeakHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style x:Key="PeakCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource GroupTintBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
        </Style>

        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="174" />
        </Grid.RowDefinitions>

        <!-- 顶部 ROI IL/RL 卡片 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="ROI IL" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding IlText}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="ROI RL" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding RlText}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 距离域曲线 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10,8,10,6">
            <vis:CurvePlotControl x:Name="Plot" />
        </Border>

        <!-- 底部：左侧参数、右侧峰表 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="12,10,12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="空间平均" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ParamInputStyle}"
                             Text="{Binding SpatialAverageText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="采集次数" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource ParamInputStyle}"
                             Margin="0,4,0,4"
                             Text="{Binding TemporalAverageText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ROI 起点" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ParamInputStyle}"
                             Text="{Binding RoiStartText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="ROI 终点" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource ParamInputStyle}"
                             Margin="0,4,0,4"
                             Text="{Binding RoiEndText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="显示上限" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ParamInputStyle}"
                             Text="{Binding DisplayMaxText, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                                Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="单次采集" Width="120" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding CanRunOnce}"
                                Click="OnSingleClick" />
                        <Button Content="{Binding ContinuousButtonText}" Width="120" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnContinuousClick" />
                        <Button Content="保存数据" Width="120" Height="32"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnSaveClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10,8,10,8">
                <DataGrid x:Name="PeakGrid"
                          ItemsSource="{Binding PeakRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource GridLineBrush}"
                          Background="{StaticResource CardBackgroundBrush}"
                          RowBackground="{StaticResource CardBackgroundBrush}"
                          BorderThickness="0"
                          RowHeight="{StaticResource TableRowHeight}"
                          ColumnHeaderHeight="34"
                          ColumnHeaderStyle="{StaticResource PeakHeaderStyle}"
                          CellStyle="{StaticResource PeakCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Number}" Width="14*"
                                            ElementStyle="{StaticResource CenteredCellStyle}" />
                        <DataGridTextColumn Header="位置 (m)" Binding="{Binding Position}" Width="38*"
                                            HeaderStyle="{StaticResource PeakRightHeaderStyle}"
                                            ElementStyle="{StaticResource RightAlignedCellStyle}" />
                        <DataGridTextColumn Header="RL (dB)" Binding="{Binding Level}" Width="32*"
                                            HeaderStyle="{StaticResource PeakRightHeaderStyle}"
                                            ElementStyle="{StaticResource RightAlignedCellStyle}" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="16*"
                                            ElementStyle="{StaticResource CenteredCellStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
